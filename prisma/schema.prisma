datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// 1. ENUMS & SECURITY TYPES
// ============================================================================

enum UserRole {
  chairman
  managing_director
  hr_head
  internal_audit_head
  compliance_statutory
  employee
}

enum PermissionLevel {
  F    // Full Access (CRUD + Approve)
  E    // Edit / Process
  A    // Approve only
  V    // View only
  S    // Self-service only
  NONE // No access
}

enum EmploymentStatus {
  active
  probation
  notice_period
  terminated
  resigned
  retired
}

enum Gender {
  male
  female
  other
  prefer_not_to_say
}

enum AttendanceStatus {
  present
  absent
  half_day
  on_leave
  holiday
  weekly_off
}

enum AttendanceSource {
  biometric
  web_checkin
  manual_override
  geofenced_mobile
}

enum LeaveStatus {
  pending
  approved
  rejected
  cancelled
}

enum LeaveTypeEnum {
  casual
  sick
  earned
  maternity
  paternity
  unpaid
  compensatory_off
}

enum PayrollStatus {
  draft
  calculated
  verified
  approved
  locked
  disbursed
}

enum CandidateStage {
  applied
  shortlisted
  technical_eval
  hr_round
  offered
  hired
  rejected
}

enum PriorityLevel {
  low
  medium
  high
  critical
}

enum GrievanceStatus {
  open
  investigating
  escalated
  resolved
  closed
}

// ============================================================================
// 2. CORE / TENANCY
// ============================================================================

model Organization {
  id                     String                  @id @default(uuid())
  name                   String
  code                   String                  @unique
  taxId                  String?
  domain                 String?
  logoUrl                String?
  status                 String                  @default("active") // "active", "suspended"
  branches               Branch[]
  departments            Department[]
  designations           Designation[]
  users                  User[]
  employees              Employee[]
  bankDetails            BankDetails[]
  statutoryInfos         StatutoryInfo[]
  emergencyContacts      EmergencyContact[]
  attendanceRecords      AttendanceRecord[]
  leaveAllocations       LeaveAllocation[]
  leaveRequests          LeaveRequest[]
  payrollRuns            PayrollRun[]
  payslips               Payslip[]
  jobRequisitions        JobRequisition[]
  candidates             Candidate[]
  performanceReviews     PerformanceReview[]
  grievanceTickets       GrievanceTicket[]
  resignationExitCases   ResignationExitCase[]
  transferPromotionCases TransferPromotionCase[]
  disciplinaryCases      DisciplinaryCase[]
  trainingPrograms       TrainingProgram[]
  companyPolicies        CompanyPolicy[]
  companyHolidays        CompanyHoliday[]
  auditLogs              AuditLog[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

model Branch {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  code           String
  city           String
  state          String
  country        String           @default("India")
  address        String?
  isHeadquarters Boolean          @default(false)
  employees      Employee[]
  holidays       CompanyHoliday[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Department {
  id                     String                  @id @default(uuid())
  organizationId         String
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name                   String
  code                   String
  description            String?
  headEmployeeId         String?
  headEmployee           Employee?               @relation("DepartmentHead", fields: [headEmployeeId], references: [id], onDelete: SetNull)
  designations           Designation[]
  employees              Employee[]
  jobRequisitions        JobRequisition[]
  transfersFrom          TransferPromotionCase[] @relation("CurrentDepartment")
  transfersTo            TransferPromotionCase[] @relation("NewDepartment")
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Designation {
  id              String                  @id @default(uuid())
  organizationId  String
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  departmentId    String
  department      Department              @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  title           String
  code            String
  gradeLevel      String?
  employees       Employee[]
  jobRequisitions JobRequisition[]
  transfersFrom   TransferPromotionCase[] @relation("CurrentDesignation")
  transfersTo     TransferPromotionCase[] @relation("NewDesignation")
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([organizationId, code])
  @@index([departmentId])
}

// ============================================================================
// 3. ACCESS CONTROL & SESSIONS
// ============================================================================

model User {
  id                  String             @id @default(uuid())
  organizationId      String
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email               String
  passwordHash        String
  name                String
  avatarUrl           String?
  roles               UserRole[]         @default([employee])
  activeRole          UserRole           @default(employee)
  status              String             @default("active") // "active", "disabled", "locked"
  employeeId          String?            @unique
  employee            Employee?          @relation("UserToEmployee", fields: [employeeId], references: [id], onDelete: SetNull)

  // Security Hardening
  mfaEnabled          Boolean            @default(false)
  mfaSecretEncrypted  String?
  failedLoginAttempts Int                @default(0)
  lockedUntil         DateTime?
  passwordChangedAt   DateTime           @default(now())
  lastLoginAt         DateTime?
  lastLoginIp         String?

  sessions            UserSession[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  regularizedRecords  AttendanceRecord[] @relation("RegularizedBy")
  calculatedRuns      PayrollRun[]       @relation("PayrollCalculatedBy")
  approvedRuns        PayrollRun[]       @relation("PayrollApprovedBy")
  assignedGrievances  GrievanceTicket[]  @relation("GrievanceAssignedTo")
  initiatedTransfers  TransferPromotionCase[] @relation("TransferInitiatedBy")
  reportedDisciplines DisciplinaryCase[] @relation("DisciplineReportedBy")
  createdPolicies     CompanyPolicy[]    @relation("PolicyCreatedBy")
  createdHolidays     CompanyHoliday[]   @relation("HolidayCreatedBy")
  approvedHolidays    CompanyHoliday[]   @relation("HolidayApprovedBy")

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
}

model UserSession {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================================
// 4. AUDIT LOG — APPEND-ONLY & HASH-CHAINED (TAMPER-EVIDENT)
// ============================================================================

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName       String
  userRole       UserRole
  action         String
  module         String
  resourceId     String?
  payloadBefore  Json?
  payloadAfter   Json?
  ipAddress      String?
  userAgent      String?
  previousHash   String       @default("GENESIS_BLOCK_0000000000000000") // Prior row's hash in org chain
  integrityHash  String       // SHA-256 (previousHash + payload)
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([resourceId])
}

// ============================================================================
// 5. EMPLOYEE MASTER DATA & EXTENSIONS
// ============================================================================

model Employee {
  id                    String                  @id @default(uuid())
  organizationId        String
  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employeeCode          String
  firstName             String
  lastName              String
  email                 String
  phone                 String
  avatarUrl             String?
  gender                Gender
  dob                   DateTime                @db.Date
  dateOfJoining         DateTime                @db.Date
  dateOfLeaving         DateTime?               @db.Date
  departmentId          String
  department            Department              @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  designationId         String
  designation           Designation             @relation(fields: [designationId], references: [id], onDelete: Restrict)
  branchId              String
  branch                Branch                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  reportingManagerId    String?
  reportingManager      Employee?               @relation("ManagerToSubordinates", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  subordinates          Employee[]              @relation("ManagerToSubordinates")
  headedDepartments     Department[]            @relation("DepartmentHead")

  employmentStatus      EmploymentStatus        @default(probation)
  currentLifecycleStage String                  @default("onboarding") // "onboarding", "active", "exit", "exited"
  ctc                   Decimal                 @db.Decimal(12, 2)

  // Direct Unified Bank, PF & Emergency info
  accountNumber         String?
  accountName           String?
  bankName              String?
  ifscCode              String?
  branchName            String?
  pan                   String?
  pfNumber              String?
  uan                   String?
  esiNumber             String?
  ptState               String?
  lwfNumber             String?
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyContactRelation String?

  user                  User?                   @relation("UserToEmployee")
  bankDetails           BankDetails?
  statutoryInfo         StatutoryInfo?
  emergencyContacts     EmergencyContact[]
  attendanceRecords     AttendanceRecord[]
  leaveAllocations      LeaveAllocation[]
  leaveRequests         LeaveRequest[]
  approvedLeaves        LeaveRequest[]          @relation("LeaveApprover")
  payslips              Payslip[]
  performanceReviews    PerformanceReview[]
  grievanceTickets      GrievanceTicket[]
  exitCase              ResignationExitCase?
  transfers             TransferPromotionCase[]
  disciplinaryCases     DisciplinaryCase[]

  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  deletedAt             DateTime?               // Soft delete: never hard delete an employee

  @@unique([organizationId, employeeCode])
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([departmentId])
  @@index([branchId])
  @@index([reportingManagerId])
  @@index([organizationId, employmentStatus])
}

model BankDetails {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employeeId     String       @unique
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  accountNumber  String       // Encrypted at app layer
  accountName    String
  bankName       String
  ifscCode       String
  branchName     String?
  pan            String       // Encrypted at app layer
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model StatutoryInfo {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employeeId     String       @unique
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  pfNumber       String?
  uan            String?
  esiNumber      String?
  ptState        String?
  lwfNumber      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model EmergencyContact {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name           String
  relationship   String
  phone          String
  alternatePhone String?
  address        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([employeeId])
}

// ============================================================================
// 6. ATTENDANCE & LEAVE (HIGH-VOLUME INDEXED)
// ============================================================================

model AttendanceRecord {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employeeId     String
  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  date           DateTime         @db.Date
  inTime         DateTime?
  outTime        DateTime?
  totalHours     Decimal?         @db.Decimal(5, 2)
  overtimeHours  Decimal          @default(0) @db.Decimal(5, 2)
  status         AttendanceStatus @default(present)
  source         AttendanceSource @default(web_checkin)
  isRegularized  Boolean          @default(false)
  regularizedById String?
  regularizedBy  User?            @relation("RegularizedBy", fields: [regularizedById], references: [id], onDelete: SetNull)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([organizationId, date])
  @@index([employeeId, date(sort: Desc)])
}

model LeaveAllocation {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employeeId     String
  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType      LeaveTypeEnum
  year           Int
  allocatedDays  Decimal       @db.Decimal(5, 2)
  usedDays       Decimal       @default(0) @db.Decimal(5, 2)
  pendingDays    Decimal       @default(0) @db.Decimal(5, 2)
  balanceDays    Decimal       @db.Decimal(5, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([employeeId, leaveType, year])
  @@index([organizationId, year])
}

model LeaveRequest {
  id              String        @id @default(uuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType       LeaveTypeEnum
  fromDate        DateTime      @db.Date
  toDate          DateTime      @db.Date
  daysCount       Decimal       @db.Decimal(5, 2)
  reason          String
  status          LeaveStatus   @default(pending)
  approverId      String?
  approver        Employee?     @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)
  approverComment String?
  processedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([organizationId, status])
  @@index([employeeId])
}

// ============================================================================
// 7. PAYROLL & COMPENSATION (CONCURRENCY HARDENED)
// ============================================================================

model PayrollRun {
  id              String        @id @default(uuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  monthYear       String        // "YYYY-MM"
  periodStart     DateTime      @db.Date
  periodEnd       DateTime      @db.Date
  totalEmployees  Int
  totalGross      Decimal       @db.Decimal(14, 2)
  totalDeductions Decimal       @db.Decimal(14, 2)
  totalNet        Decimal       @db.Decimal(14, 2)
  status          PayrollStatus @default(draft)
  calculatedById  String
  calculatedByUser User         @relation("PayrollCalculatedBy", fields: [calculatedById], references: [id], onDelete: Restrict)
  approvedById    String?
  approvedByUser  User?         @relation("PayrollApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  version         Int           @default(1) // Optimistic concurrency lock
  payslips        Payslip[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([organizationId, monthYear])
}

model Payslip {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payrollRunId     String
  payrollRun       PayrollRun   @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  employeeId       String
  employee         Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  period           String
  basicSalary      Decimal      @db.Decimal(12, 2)
  hra              Decimal      @db.Decimal(12, 2)
  specialAllowance Decimal      @db.Decimal(12, 2)
  conveyance       Decimal      @db.Decimal(12, 2)
  medical          Decimal      @db.Decimal(12, 2)
  grossEarnings    Decimal      @db.Decimal(12, 2)
  pfDeduction      Decimal      @db.Decimal(12, 2)
  esiDeduction     Decimal      @db.Decimal(12, 2)
  professionalTax  Decimal      @db.Decimal(12, 2)
  incomeTaxTds     Decimal      @db.Decimal(12, 2)
  totalDeductions  Decimal      @db.Decimal(12, 2)
  netPay           Decimal      @db.Decimal(12, 2)
  paymentMode      String       @default("Bank Transfer")
  paymentStatus    String       @default("Processed") // "Processed", "Pending", "Failed", "Reversed"
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
  @@index([organizationId, period])
}

// ============================================================================
// 8. TALENT ACQUISITION (ATS)
// ============================================================================

model JobRequisition {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  departmentId   String
  department     Department    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  designationId  String
  designation    Designation   @relation(fields: [designationId], references: [id], onDelete: Restrict)
  title          String
  headcount      Int           @default(1)
  status         String        @default("active") // "active", "on_hold", "closed", "cancelled"
  experienceMin  Int           @default(0)
  experienceMax  Int           @default(5)
  budgetMin      Decimal       @db.Decimal(12, 2)
  budgetMax      Decimal       @db.Decimal(12, 2)
  candidates     Candidate[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, status])
}

model Candidate {
  id               String         @id @default(uuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  jobRequisitionId String
  jobRequisition   JobRequisition @relation(fields: [jobRequisitionId], references: [id], onDelete: Cascade)
  candidateCode    String
  name             String
  email            String
  phone            String
  stage            CandidateStage @default(applied)
  experienceYears  Decimal        @db.Decimal(4, 1)
  currentCtc       Decimal?       @db.Decimal(12, 2)
  expectedCtc      Decimal?       @db.Decimal(12, 2)
  rating           Decimal?       @db.Decimal(2, 1)
  matchScore       Int?
  interviewDate    DateTime?
  interviewerName  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([organizationId, candidateCode])
  @@index([jobRequisitionId])
  @@index([organizationId, stage])
}

// ============================================================================
// 9. PERFORMANCE & GRIEVANCE
// ============================================================================

model PerformanceReview {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycleName      String
  selfRating     Decimal      @db.Decimal(2, 1)
  managerRating  Decimal      @db.Decimal(2, 1)
  finalRating    Decimal      @db.Decimal(2, 1)
  kraScore       Decimal      @db.Decimal(5, 2)
  nineBoxGrid    String
  status         String       @default("in_progress") // "in_progress", "completed", "cancelled"
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([employeeId, cycleName])
  @@index([employeeId])
}

model GrievanceTicket {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employeeId     String?         // Nullable for anonymous tickets
  employee       Employee?       @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  category       String
  subject        String
  description    String
  isAnonymous    Boolean         @default(false)
  priority       PriorityLevel   @default(medium)
  status         GrievanceStatus @default(open)
  assignedToId   String?
  assignedTo     User?           @relation("GrievanceAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolution     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId, status])
}

// ============================================================================
// 10. EXIT, TRANSFERS & DISCIPLINE
// ============================================================================

model ResignationExitCase {
  id                     String       @id @default(uuid())
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employeeId             String       @unique
  employee               Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  resignationDate        DateTime     @db.Date
  lastWorkingDay         DateTime     @db.Date
  reason                 String
  noticePeriodDays       Int          @default(60)
  itClearanceStatus      String       @default("pending") // "pending", "cleared", "flagged"
  deptClearanceStatus    String       @default("pending")
  financeClearanceStatus String       @default("pending")
  fnfAmount              Decimal      @db.Decimal(12, 2)
  fnfStatus              String       @default("pending") // "pending", "processed", "disputed"
  certificateIssued      Boolean      @default(false)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
}

model TransferPromotionCase {
  id                    String       @id @default(uuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employeeId            String
  employee              Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type                  String       // "transfer", "promotion", "both"
  currentDepartmentId   String
  currentDepartment     Department   @relation("CurrentDepartment", fields: [currentDepartmentId], references: [id], onDelete: Restrict)
  newDepartmentId       String
  newDepartment         Department   @relation("NewDepartment", fields: [newDepartmentId], references: [id], onDelete: Restrict)
  currentDesignationId  String
  currentDesignation    Designation  @relation("CurrentDesignation", fields: [currentDesignationId], references: [id], onDelete: Restrict)
  newDesignationId      String
  newDesignation        Designation  @relation("NewDesignation", fields: [newDesignationId], references: [id], onDelete: Restrict)
  currentBranchId       String
  newBranchId           String
  effectiveDate         DateTime     @db.Date
  initiatedById         String
  initiatedByUser       User         @relation("TransferInitiatedBy", fields: [initiatedById], references: [id], onDelete: Restrict)
  status                String       @default("pending") // "pending", "approved", "rejected", "completed"
  approvalChain         Json         @default("[]")
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([employeeId])
}

model DisciplinaryCase {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  caseNumber     String
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  violationType  String
  incidentDate   DateTime     @db.Date
  reportedById   String
  reportedByUser User         @relation("DisciplineReportedBy", fields: [reportedById], references: [id], onDelete: Restrict)
  severity       String       @default("medium") // "low", "medium", "high", "critical"
  currentStage   String       @default("show_cause_notice") // "show_cause_notice", "investigation", "hearing", "action_taken", "closed"
  actionTaken    String?
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, caseNumber])
  @@index([employeeId])
}

// ============================================================================
// 11. NOTIFICATIONS, TRAINING, POLICIES & HOLIDAYS
// ============================================================================

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("info") // "info", "warning", "success", "error"
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

model TrainingProgram {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  title          String
  category       String
  trainer        String
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  mode           String       @default("internal") // "internal", "external", "online"
  vendorName     String?
  capacity       Int          @default(30)
  enrolledCount  Int          @default(0)
  status         String       @default("upcoming") // "upcoming", "ongoing", "completed", "cancelled"
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
}

model CompanyPolicy {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  title             String
  category          String
  version           String
  effectiveDate     DateTime     @db.Date
  content           String?
  status            String       @default("active") // "draft", "active", "archived"
  createdById       String?
  createdByUser     User?        @relation("PolicyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdByName     String?
  createdByRole     UserRole     @default(hr_head)
  acknowledgedCount Int          @default(0)
  fileUrl           String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([organizationId, title, version])
  @@index([organizationId, status])
}

model CompanyHoliday {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  title          String
  date           DateTime     @db.Date
  dayOfWeek      String
  category       String       @default("mandatory") // "mandatory", "optional", "restricted"
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  description    String?
  status         String       @default("approved") // "proposed", "approved", "rejected"
  createdById    String?
  createdByUser  User?        @relation("HolidayCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdByName  String?
  createdByRole  UserRole     @default(hr_head)
  approvedById   String?
  approvedByUser User?        @relation("HolidayApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedByName String?
  approvedByRole UserRole?
  year           Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, date, branchId])
  @@index([organizationId, year])
}
